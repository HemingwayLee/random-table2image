FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# generate.sh runs on Node. Take Node and npm from the official image instead of Debian's older package.
COPY --from=node:22-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && apt-get update && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# The generator's Node dependencies, installed at build time. generate.sh and core/ are bind-mounted over
# /generator at run time (see docker-compose.dev.yml); a volume keeps this node_modules.
COPY --from=generator package.json package-lock.json /generator/core/
RUN npm ci --prefix /generator/core --omit=dev

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8766
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8766", "--reload"]
